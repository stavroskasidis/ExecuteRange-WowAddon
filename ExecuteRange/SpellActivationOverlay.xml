<!--
Custom import of Blizzard's SpellActivationOverlay.xml, see SpellActivationOverlay.lua for the frame layout.
-->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<Frame name="ExecuteRangeSpellActivationOverlayTemplate" virtual="true">
		<Animations>
			<AnimationGroup parentKey="animIn">
				<Alpha fromAlpha="0" toAlpha="1" duration="0.2"/>
				<Scripts>
					<OnPlay>ExecuteRange_SpellActivationOverlay:SpellActivationOverlayTexture_OnFadeInPlay(self)</OnPlay>
					<OnFinished>ExecuteRange_SpellActivationOverlay:SpellActivationOverlayTexture_OnFadeInFinished(self)</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="animOut">
				<Alpha fromAlpha="1" toAlpha="0" duration="0.1"/>
				<Scripts>
					<OnFinished>ExecuteRange_SpellActivationOverlay:SpellActivationOverlayTexture_OnFadeOutFinished(self)</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup looping="REPEAT" parentKey="pulse">
				<Scale scaleX="1.08" scaleY="1.08" duration="0.5" smoothing="IN_OUT" order="1"/>
				<Scale scaleX="0.9259" scaleY="0.9259" duration="0.5" smoothing="IN_OUT" order="2"/>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="texture" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnShow>ExecuteRange_SpellActivationOverlay:SpellActivationOverlayTexture_OnShow(self)</OnShow>
		</Scripts>
	</Frame>

	<!-- Live alert: the overlay frame sits under two gate frames whose alpha SpellAlertsHandler drives -->
	<Frame name="ExecuteRangeAlertGateFrame" parent="UIParent">
		<Size x="1" y="1"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<Frame parentKey="CooldownGate">
				<Size x="1" y="1"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Frames>
					<Frame name="ExecuteRangeSpellActivationOverlayFrame" mixin="ExecuteRange_SpellActivationOverlay">
						<Size x="256" y="256"/>
						<Anchors>
							<Anchor point="CENTER"/>
						</Anchors>
						<Scripts>
							<OnLoad method="OnLoad"/>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>
		</Frames>
	</Frame>

	<!-- Settings "Preview": above the settings panel and never gated -->
	<Frame name="ExecuteRangeSpellActivationOverlayPreviewFrame" mixin="ExecuteRange_SpellActivationOverlay" parent="UIParent" frameStrata="FULLSCREEN_DIALOG">
		<Size x="256" y="256"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
